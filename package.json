{
  "name": "unifide-marketing-release",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.19.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "test:http": "node scripts/test-http.mjs",
    "check": "node --check scripts/build.mjs && node --check src/render.mjs && node --check src/assets/app.js && node --test tests/*.test.mjs"
  }
}
